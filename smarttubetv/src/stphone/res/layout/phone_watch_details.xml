<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/watch_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="6dp"
        android:textColor="#FFFFFF" android:textSize="19sp" android:fontFamily="sans-serif-medium"
        android:clickable="true" android:background="?android:attr/selectableItemBackground" />
    <TextView android:id="@+id/watch_metadata" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="#AAAAAA" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:padding="12dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/watch_avatar" android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/watch_avatar_bg" android:importantForAccessibility="no" />
        <TextView android:id="@+id/watch_channel" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="#FFFFFF"
            android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="2" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:paddingStart="8dp" android:paddingEnd="8dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/watch_share" style="@style/WatchPill" android:text="@string/watch_share" />
            <Button android:id="@+id/watch_quality" style="@style/WatchPill" android:text="@string/watch_quality" />
            <Button android:id="@+id/watch_speed" style="@style/WatchPill" android:text="@string/watch_speed" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView android:id="@+id/watch_description" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="12dp" android:padding="12dp" android:background="@drawable/watch_pill_bg"
        android:textColor="#DDDDDD" android:textSize="13sp" android:lineSpacingExtra="3dp"
        android:maxLines="2" android:ellipsize="end" android:clickable="true" />
    <TextView android:id="@+id/watch_related_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="12dp"
        android:text="@string/watch_related" android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
</LinearLayout>
