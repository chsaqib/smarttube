<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/youtube_black"
    android:fitsSystemWindows="true">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/youtube_black">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_youtube_play"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/phone_app_name"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/phone_header_search_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_search_tab"
            android:contentDescription="@string/phone_search"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Search Input Area -->
    <LinearLayout
        android:id="@+id/phone_search_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/phone_search"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:background="@drawable/rounded_search_box"
            android:hint="@string/phone_search_hint"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="14sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <Button
            android:id="@+id/phone_search_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/youtube_red"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="@string/phone_search" />
    </LinearLayout>

    <TextView
        android:id="@+id/phone_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:accessibilityLiveRegion="polite" />

    <ProgressBar
        android:id="@+id/phone_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/youtube_red" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/phone_feed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/phone_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:backgroundTint="#212121"
        android:textColor="#FFFFFF"
        android:text="@string/phone_load_more"
        android:visibility="gone" />

    <!-- YouTube Bottom Navigation Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#272727" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/youtube_black">

        <LinearLayout
            android:id="@+id/phone_home_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home_tab"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_home"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:paddingTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phone_trending_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_trending_tab"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_trending"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:paddingTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phone_search_tab_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search_tab"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_search"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:paddingTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
